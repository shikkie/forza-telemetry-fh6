# =============================================================================
# Forza Horizon 6 Telemetry Collector - Configuration
# Copy this file to .env and adjust values as needed.
# =============================================================================

# --- UDP Collector ---
FORZA_UDP_HOST=0.0.0.0
FORZA_UDP_PORT=20066

# --- MongoDB ---
# For local development (docker-compose):
# Note: We map Mongo to host port 27018 to avoid conflicts with other Mongo instances
MONGO_URI=mongodb://localhost:27018
MONGO_DB=forza_telemetry_fh6

# For Docker Compose internal network (recommended):
# MONGO_URI=mongodb://mongo:27017
# MONGO_DB=forza_telemetry_fh6

# --- Unix Socket for Dashboard <-> Collector ---
SOCKET_PATH=/tmp/forza-telemetry.sock

# --- Storage Sampling ---
# Store raw 324-byte packet every N packets (1 = every packet, high volume!)
RAW_STORAGE_INTERVAL=1

# Store parsed telemetry document every N packets (good for queries, 5 = ~12Hz at 60fps)
PARSED_STORAGE_INTERVAL=5

# --- Dashboard / Collector Behavior ---
# Max rate (Hz) to push live data to attached displays
LIVE_UPDATE_HZ=30

# Speed unit shown in the live dashboard ("mph" or "kmh")
SPEED_UNIT=mph

# Power unit shown in the dashboard ("kw", "hp", or "ps")
POWER_UNIT=hp

# Auto-close session after this many seconds of no IsRaceOn packets
SESSION_IDLE_TIMEOUT_SEC=300

# --- Logging ---
LOG_LEVEL=INFO
# LOG_LEVEL=DEBUG for development

# --- Advanced ---
# Enable detailed packet validation (slower, for debugging)
STRICT_PACKET_VALIDATION=false
