# Production Dockerfile for Flask API
FROM python:3.12-slim

WORKDIR /app

# Install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY api/ ./api/
COPY src/forza_telemetry/cars.py ./src/forza_telemetry/cars.py

ENV PYTHONPATH=/app
ENV FLASK_APP=api.app:create_app

# Production server
EXPOSE 5000

# Use gunicorn for production
CMD ["gunicorn", "--workers", "4", "--bind", "0.0.0.0:5000", "api.app:create_app()"]