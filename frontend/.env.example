# When running the frontend with `npm run dev`, this tells Vite where to proxy /api requests.
# Default is http://localhost:5003 (matches the port used by dev.sh for the API).
VITE_API_TARGET=http://localhost:5003

# Optional: If you are NOT using the Vite proxy (e.g. in production or when hitting the API directly),
# you can set a base URL here. Leave empty when using the proxy.
# VITE_API_BASE=http://localhost:5003
